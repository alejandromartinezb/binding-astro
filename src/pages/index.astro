---
// src/pages/index.astro
// Página de inicio del sitio. Aquí se combinan las secciones del home.
import Layout from "../layouts/Layout.astro";
import Hero from "../components/home/Hero.astro";
import HowItWorks from "../components/home/HowItWorks.astro";
import Features from "../components/home/Features.astro";
import Solutions from "../components/home/Solutions.astro";
import { getMessages, t } from "../utils/i18n";
const messages = getMessages('es');
---

<Layout title={t(messages, 'home.hero.title') + ' | Binding Software'} pathname="/">
  <!-- Componentes principales de la página de inicio -->
  <Hero lang="es" />
  <HowItWorks lang="es" />
  <Features lang="es" />
  <Solutions lang="es" />
</Layout>
