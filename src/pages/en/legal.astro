---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Legal Notice | Binding Software" pathname="/en/legal">
    <section class="page-section">
        <div class="page-content">
            <p class="eyebrow">Legal Notice</p>
            <h1>Terms of use</h1>
            <p>
                This page contains the general terms and conditions for using the Binding Software website.
                Using this site means you accept this legal notice.
            </p>
            <p>
                For any questions about data processing or intellectual property, please contact us at
                <a href="mailto:sales@bindingsoftware.com">sales@bindingsoftware.com</a>.
            </p>
        </div>
    </section>
</Layout>

<style>
    .page-section {
        padding: 4rem 1.5rem;
    }

    .page-content {
        max-width: 720px;
        margin: 0 auto;
        color: var(--color-base-2);
    }

    .eyebrow {
        display: inline-block;
        margin-bottom: 1rem;
        color: var(--color-enfasis);
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        font-size: 0.85rem;
    }

    h1 {
        margin: 0 0 1.25rem;
        font-size: clamp(2rem, 4vw, 3rem);
        line-height: 1.1;
        color: var(--color-contraste-1);
    }

    p {
        font-size: 1rem;
        line-height: 1.8;
    }

    a {
        color: var(--color-contraste-2);
        text-decoration: none;
    }

    a:hover {
        text-decoration: underline;
    }
</style>
