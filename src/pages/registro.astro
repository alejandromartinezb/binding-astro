---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Registro | Binding Software">
    <main class="registration-page">
        <section class="registration-panel" aria-labelledby="registro-title">
            <p class="eyebrow">Registro cliente hotelero</p>
            <h1 id="registro-title">Registra tu hotel</h1>
            <p class="intro">
                Crea tu cuenta de cliente para gestión de soluciones de check-in, cumplimiento y datos de tu hotel o cadena.
            </p>

            <div class="status" role="status" aria-live="polite" id="form-status">
                <p>Campos obligatorios marcados con <strong>*</strong>.</p>
            </div>

            <form class="registration-form" method="post" action="/registro" novalidate>
                <fieldset>
                    <legend>Datos de la empresa</legend>
                    <p class="field-hint">Indica la información de tu hotel o cadena para que Binding pueda darte acceso rápido.</p>

                    <div class="field-group">
                        <label for="hotelName">Nombre del hotel o empresa <span aria-hidden="true">*</span></label>
                        <input id="hotelName" name="hotelName" type="text" required aria-required="true" placeholder="Ej. Hotel Gran Vista" />
                    </div>

                    <div class="field-group">
                        <label for="contactName">Nombre del responsable <span aria-hidden="true">*</span></label>
                        <input id="contactName" name="contactName" type="text" required aria-required="true" autocomplete="name" placeholder="Ej. Laura Pérez" />
                    </div>

                    <div class="field-group">
                        <label for="role">Cargo o función <span aria-hidden="true">*</span></label>
                        <input id="role" name="role" type="text" required aria-required="true" placeholder="Ej. Propietario / Director general" />
                    </div>
                </fieldset>

                <fieldset>
                    <legend>Contacto</legend>
                    <p class="field-hint">Usaremos estos datos para crear tu cuenta y enviarte información comercial y de acceso.</p>

                    <div class="field-group">
                        <label for="email">Email de contacto <span aria-hidden="true">*</span></label>
                        <input id="email" name="email" type="email" required aria-required="true" autocomplete="email" placeholder="contacto@hotel.com" />
                    </div>

                    <div class="field-group">
                        <label for="phone">Teléfono <span aria-hidden="true">*</span></label>
                        <input id="phone" name="phone" type="tel" required aria-required="true" autocomplete="tel" pattern="[0-9+\s-]{7,20}" placeholder="+34 600 123 456" />
                    </div>

                    <div class="field-group">
                        <label for="website">Página web</label>
                        <input id="website" name="website" type="url" autocomplete="url" placeholder="https://www.tuhotel.com" />
                    </div>
                </fieldset>

                <fieldset>
                    <legend>Sobre el hotel</legend>

                    <div class="field-group">
                        <label for="location">Ciudad / país <span aria-hidden="true">*</span></label>
                        <input id="location" name="location" type="text" required aria-required="true" placeholder="Ej. Madrid, España" />
                    </div>

                    <div class="field-group">
                        <label for="rooms">Número aproximado de habitaciones <span aria-hidden="true">*</span></label>
                        <input id="rooms" name="rooms" type="number" min="1" max="1000" required aria-required="true" placeholder="Ej. 120" />
                    </div>

                    <div class="field-group">
                        <label for="hotelType">Tipo de establecimiento <span aria-hidden="true">*</span></label>
                        <select id="hotelType" name="hotelType" required aria-required="true">
                            <option value="">Selecciona una opción</option>
                            <option value="independiente">Hotel independiente</option>
                            <option value="cadena">Cadena hotelera</option>
                            <option value="resort">Resort</option>
                            <option value="apartahotel">Aparthotel</option>
                        </select>
                    </div>
                </fieldset>

                <fieldset>
                    <legend>Interés en soluciones</legend>
                    <p class="field-hint">Cuéntanos qué necesitas para adaptar la demo a tu negocio.</p>

                    <div class="field-group">
                        <label for="solutionType">Qué soluciones te interesan <span aria-hidden="true">*</span></label>
                        <select id="solutionType" name="solutionType" required aria-required="true">
                            <option value="">Selecciona una opción</option>
                            <option value="registro-electronico">Registro electrónico de huéspedes</option>
                            <option value="checkin-sin-papel">Check-in sin papel</option>
                            <option value="firma-digital">Firma digital</option>
                            <option value="gestion-autoridades">Gestión de informes a autoridades</option>
                        </select>
                    </div>

                    <div class="field-group">
                        <label for="notes">Comentarios adicionales</label>
                        <textarea id="notes" name="notes" rows="4" placeholder="Describe tus necesidades, procesos actuales o integraciones deseadas."></textarea>
                    </div>
                </fieldset>

                <fieldset>
                    <legend>Privacidad y consentimiento</legend>
                    <div class="field-group consent-group">
                        <input id="consent" name="consent" type="checkbox" required aria-required="true" />
                        <label for="consent">
                            Acepto el tratamiento de datos conforme a la política de privacidad.
                        </label>
                    </div>
                </fieldset>

                <button type="submit" class="primary-button">Enviar registro</button>
            </form>
            <script>
                document.addEventListener('DOMContentLoaded', () => {
                    const form = document.querySelector<HTMLFormElement>('.registration-form');
                    const emailInput = document.getElementById('email') as HTMLInputElement | null;
                    const nameInput = document.getElementById('contactName') as HTMLInputElement | null;
                    if (!form || !emailInput || !nameInput) return;

                    form.addEventListener('submit', () => {
                        try {
                            const consent = window.cookieUtils.getCookie('cookie_consent') === 'accepted';
                            const prefs = window.cookieUtils.getCookie('cookie_consent_prefs');
                            const functional = prefs ? JSON.parse(prefs).functional : false;
                            if (consent && functional) {
                                window.storageUtils.setLocal('registered_email', emailInput.value || '');
                                window.storageUtils.setLocal('registered_contact_name', nameInput.value || '');
                            }
                        } catch {
                            // no-op
                        }
                    });
                });
            </script>
        </section>
    </main>
</Layout>

<style>
    .registration-page {
        padding: 2rem 1rem;
        display: flex;
        justify-content: center;
    }

    .registration-panel {
        width: min(980px, 100%);
        background: rgba(255, 255, 255, 0.96);
        border-radius: 28px;
        border: 1px solid rgba(63, 66, 56, 0.14);
        padding: 2.5rem;
        box-shadow: 0 24px 48px rgba(0, 0, 0, 0.08);
    }

    .eyebrow {
        display: inline-flex;
        padding: 0.55rem 1rem;
        border-radius: 999px;
        background: rgba(79, 70, 229, 0.1);
        color: var(--color-contraste-1);
        font-weight: 700;
        font-size: 0.9rem;
        margin-bottom: 1rem;
    }

    h1 {
        margin: 0 0 0.75rem;
        font-size: clamp(2rem, 3vw, 2.75rem);
        color: var(--color-base-2);
    }

    .intro,
    .field-hint {
        color: var(--color-parrafo);
        line-height: 1.8;
        margin: 0 0 1.25rem;
    }

    .status {
        margin-bottom: 1.5rem;
        padding: 1rem 1.25rem;
        border: 1px solid rgba(63, 66, 56, 0.12);
        border-radius: 20px;
        background: rgba(247, 250, 252, 0.9);
        color: var(--color-base-2);
    }

    .registration-form {
        display: grid;
        gap: 1.5rem;
    }

    fieldset {
        border: 1px solid rgba(63, 66, 56, 0.14);
        border-radius: 20px;
        padding: 1.5rem;
        background: rgba(242, 242, 242, 0.18);
    }

    legend {
        font-weight: 700;
        color: var(--color-base-2);
        padding: 0 0.5rem;
    }

    .field-group {
        display: grid;
        gap: 1rem;
        margin-bottom: 1rem;
    }

    .group-label {
        font-weight: 700;
        color: var(--color-base-2);
    }

    label {
        font-weight: 600;
        color: var(--color-base-2);
    }

    input,
    select,
    textarea {
        border: 1px solid rgba(63, 66, 56, 0.18);
        border-radius: 16px;
        padding: 0.95rem 1rem;
        font-size: 1rem;
        font-family: inherit;
    }

    input:focus-visible,
    select:focus-visible,
    textarea:focus-visible,
    button:focus-visible,
    a:focus-visible {
        outline: 3px solid var(--color-contraste-2);
        outline-offset: 3px;
    }

    select {
        appearance: none;
        background-image: linear-gradient(45deg, transparent 50%, var(--color-base-2) 50%),
            linear-gradient(135deg, var(--color-base-2) 50%, transparent 50%);
        background-position: calc(100% - 1rem) calc(1rem + 2px), calc(100% - 0.7rem) calc(1rem + 2px);
        background-size: 8px 8px, 8px 8px;
        background-repeat: no-repeat;
    }

    .radio-group {
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
    }

    .radio-group label {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        font-weight: 500;
    }

    .consent-group {
        grid-template-columns: auto 1fr;
        align-items: flex-start;
        gap: 0.75rem;
    }

    .primary-button {
        width: fit-content;
        border: none;
        border-radius: 999px;
        padding: 1rem 1.5rem;
        background: var(--color-contraste-2);
        color: var(--color-base-1);
        font-size: 1rem;
        cursor: pointer;
        transition: background 0.2s ease, transform 0.2s ease;
    }

    .primary-button:hover {
        background: var(--color-enfasis);
        transform: translateY(-1px);
    }

    @media (max-width: 720px) {
        .registration-panel {
            padding: 1.5rem;
        }

        .consent-group {
            display: grid;
        }
    }
</style>
