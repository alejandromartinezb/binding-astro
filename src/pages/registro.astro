---
import Layout from "../layouts/Layout.astro";
import RegistroForm from "../components/RegistroForm.astro";
import { getMessages, t } from "../utils/i18n";
const messages = getMessages('es');
---

<Layout title={t(messages, 'registro.title')} pathname="/registro">
    <main class="registration-page">
        <RegistroForm lang="es" />
    </main>
</Layout>

<style>

    h1 {
        margin: 0 0 0.75rem;
        font-size: clamp(2rem, 3vw, 2.75rem);
        color: var(--color-base-2);
    }

    .intro,
    .field-hint {
        color: var(--color-parrafo);
        line-height: 1.8;
        margin: 0 0 1.25rem;
    }

    .status {
        margin-bottom: 1.5rem;
        padding: 1rem 1.25rem;
        border: 1px solid rgba(63, 66, 56, 0.12);
        border-radius: 20px;
        background: rgba(247, 250, 252, 0.9);
        color: var(--color-base-2);
    }

    .registration-form {
        display: grid;
        gap: 1.5rem;
    }

    fieldset {
        border: 1px solid rgba(63, 66, 56, 0.14);
        border-radius: 20px;
        padding: 1.5rem;
        background: rgba(242, 242, 242, 0.18);
    }

    legend {
        font-weight: 700;
        color: var(--color-base-2);
        padding: 0 0.5rem;
    }

    .field-group {
        display: grid;
        gap: 1rem;
        margin-bottom: 1rem;
    }

    .group-label {
        font-weight: 700;
        color: var(--color-base-2);
    }

    label {
        font-weight: 600;
        color: var(--color-base-2);
    }

    input,
    select,
    textarea {
        border: 1px solid rgba(63, 66, 56, 0.18);
        border-radius: 16px;
        padding: 0.95rem 1rem;
        font-size: 1rem;
        font-family: inherit;
    }

    input:focus-visible,
    select:focus-visible,
    textarea:focus-visible,
    button:focus-visible,
    a:focus-visible {
        outline: 3px solid var(--color-contraste-2);
        outline-offset: 3px;
    }

    select {
        appearance: none;
        background-image: linear-gradient(45deg, transparent 50%, var(--color-base-2) 50%),
            linear-gradient(135deg, var(--color-base-2) 50%, transparent 50%);
        background-position: calc(100% - 1rem) calc(1rem + 2px), calc(100% - 0.7rem) calc(1rem + 2px);
        background-size: 8px 8px, 8px 8px;
        background-repeat: no-repeat;
    }

    .radio-group {
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
    }

    .radio-group label {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        font-weight: 500;
    }

    .consent-group {
        grid-template-columns: auto 1fr;
        align-items: flex-start;
        gap: 0.75rem;
    }

    .primary-button {
        width: fit-content;
        border: none;
        border-radius: 999px;
        padding: 1rem 1.5rem;
        background: var(--color-contraste-2);
        color: var(--color-base-1);
        font-size: 1rem;
        cursor: pointer;
        transition: background 0.2s ease, transform 0.2s ease;
    }

    .primary-button:hover {
        background: var(--color-enfasis);
        transform: translateY(-1px);
    }

    @media (max-width: 720px) {
        .registration-panel {
            padding: 1.5rem;
        }

        .consent-group {
            display: grid;
        }
    }
</style>
