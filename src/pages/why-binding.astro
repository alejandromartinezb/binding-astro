---
// src/pages/why-binding.astro
// Página de tipo configurador para mostrar por qué elegir Binding.
import Layout from "../layouts/Layout.astro";

import OptionsList from "../components/configurator/OptionsList.astro";
---

<Layout title="¿Por qué Binding? | Juego Interactivo">
    <main>
        <!-- Bloque de introducción de la página -->
        <section class="intro">
            <h1>Personaliza tu hotel con Binding</h1>
            <p>
                Elige una opción en cada paso y descubre qué tan seguro está tu
                negocio.
            </p>
        </section>

        <!-- Componente que muestra las preguntas del configurador -->
        <OptionsList />
    </main>
</Layout>

<style>
    main {
        padding: 2rem;
        max-width: 900px;
        margin: 0 auto;
        text-align: center;
    }
    h1 {
        color: #4f46e5;
        font-size: 2.5rem;
    }
    .intro {
        margin-bottom: 3rem;
    }
</style>
