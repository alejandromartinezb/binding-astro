---
// src/pages/why-binding.astro
// Página para explicar por qué elegir Binding y mostrar el comparador al final.
import Layout from "../layouts/Layout.astro";
import { getMessages, t, getPathWithLang } from "../utils/i18n";

const messages = getMessages('es');
---

<Layout title={t(messages, 'whyBinding.title')} pathname="/why-binding">
    <main>
        <section class="hero">
            <div class="hero__eyebrow">Check-in en 20"</div>
            <h1>Binding Software</h1>
            <p class="hero__subtitle">De hoteleros para hoteleros</p>
        </section>

        <section class="section section--challenge">
            <div class="section__head">
                <span class="section__label">El reto</span>
                <h2>El momento más crítico: la llegada</h2>
                <p>4-6 min. por check-in</p>
            </div>

            <div class="grid grid--challenge">
                {messages.whyBinding.challenge.cards.map((card) => (
                    <article class="card card--warning">
                        <span class="card-icon">⚠️</span>
                        <h3>{card}</h3>
                    </article>
                ))}
            </div>

            <div class="challenge-columns">
                {messages.whyBinding.challenge.columns.map((column) => (
                    <div class="challenge-block">
                        <h3>{column.title}</h3>
                        <ul>
                            {column.items.map((item) => (
                                <li>{item}</li>
                            ))}
                        </ul>
                    </div>
                ))}
            </div>
        </section>

        <section class="section section--solution">
            <div class="section__head">
                <span class="section__label">La solución</span>
                <h2>Una recepción simplificada y unificada</h2>
            </div>

            <div class="grid grid--solution">
                {messages.whyBinding.solution.cards.map((card) => (
                    <article class="solution-card">
                        <span class="solution-icon">{card.icon}</span>
                        <h3>{card.title}</h3>
                        <p>{card.text}</p>
                    </article>
                ))}
            </div>

            <div class="solution-highlight">
                <h3>{t(messages, 'whyBinding.solution.highlightTitle')}</h3>
                <p>{t(messages, 'whyBinding.solution.highlightText')}</p>
            </div>
        </section>

        <section class="section section--impact">
            <div class="section__head">
                <span class="section__label">Impacto</span>
                <h2>Retorno tangible desde el primer día</h2>
            </div>

            <div class="grid grid--impact">
                <article class="impact-card">
                    <strong>&gt;600 min/día</strong>
                    <p>Liberados en recepción.</p>
                </article>
                <article class="impact-card">
                    <strong>95 %</strong>
                    <p>Reducción del tiempo de check-in.</p>
                </article>
                <article class="impact-card">
                    <strong>100 %</strong>
                    <p>Legal y con reportes SES.</p>
                </article>
            </div>

            <div class="impact-details">
                {messages.whyBinding.impact.details.map((detail) => (
                    <p>{detail}</p>
                ))}
            </div>
        </section>

        <section class="section section--roi">
            <div class="section__head">
                <span class="section__label">ROI</span>
                <h2>Impacto económico por hotel anual</h2>
            </div>

            <div class="grid grid--roi">
                {messages.whyBinding.roi.cards.map((card) => (
                    <article class="roi-card">
                        <h3>{card.title}</h3>
                        <p>{card.value}</p>
                        <small>{card.note}</small>
                    </article>
                ))}
            </div>

            <div class="roi-summary">
                {messages.whyBinding.roi.summary.map((line) => (
                    <p>{line}</p>
                ))}
            </div>
        </section>

        <section class="section section--cta">
            <div class="cta-card">
                <div>
                    <span class="section__label">Tu propia solución</span>
                    <h2>Diseña el proceso que quieres para tu hotel</h2>
                    <p>Accede al configurador y define los parámetros de tu negocio para ver cómo se adapta Binding.</p>
                </div>
                <a class="btn-secondary" href={getPathWithLang('/configurador', 'es')}>{t(messages, 'whyBinding.cta.button')}</a>
            </div>
        </section>
    </main>
</Layout>

<style>
    main {
        padding: 2rem;
        max-width: 1080px;
        margin: 0 auto;
        text-align: center;
    }

    .hero {
        padding: 2.5rem 1.5rem 2rem;
        margin-bottom: 2.5rem;
        border-radius: 32px;
        background: linear-gradient(135deg, rgba(238, 242, 255, 0.8), rgba(255, 255, 255, 0.95));
        border: 1px solid rgba(79, 70, 229, 0.12);
        box-shadow: 0 24px 48px rgba(79, 70, 229, 0.08);
    }
    .hero__eyebrow {
        display: inline-flex;
        background: rgba(79, 70, 229, 0.12);
        color: var(--color-contraste-1);
        font-weight: 700;
        padding: 0.55rem 1rem;
        border-radius: 999px;
        margin-bottom: 1rem;
        font-size: 0.95rem;
    }
    .hero h1 {
        font-size: clamp(2.5rem, 4vw, 4rem);
        margin: 0;
        color: #1f2937;
        line-height: 1;
    }
    .hero__subtitle {
        color: #475569;
        font-size: 1.1rem;
        margin: 1rem auto 0;
        max-width: 760px;
        line-height: 1.9;
    }

    .section {
        margin-bottom: 3rem;
        padding: 0 1rem;
        text-align: left;
    }
    .section__head {
        max-width: 760px;
        margin: 0 auto 1.75rem;
    }
    .section__label {
        display: inline-block;
        color: var(--color-contraste-2);
        text-transform: uppercase;
        font-size: 0.8rem;
        letter-spacing: 0.15em;
        font-weight: 700;
        margin-bottom: 0.75rem;
    }
    .section h2 {
        margin: 0;
        font-size: 2rem;
        color: #111827;
        line-height: 1.1;
    }
    .section p {
        color: #475569;
        line-height: 1.8;
        margin: 1rem 0 0;
    }

    .grid {
        display: grid;
        gap: 1.25rem;
    }

    .grid--challenge {
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        margin-bottom: 2rem;
    }
    .card {
        padding: 1.5rem;
        border-radius: 18px;
        background: #fff;
        box-shadow: 0 16px 32px rgba(15, 23, 42, 0.06);
        text-align: left;
    }
    .card--warning {
        border: 1px solid rgba(57, 119, 180, 0.2);
        background: rgba(57, 119, 180, 0.06);
    }
    .card--warning h3 {
        color: var(--color-base-2);
        margin: 0;
        font-size: 1.1rem;
    }

    .challenge-columns {
        display: grid;
        gap: 1.25rem;
    }
    .challenge-block {
        padding: 1.75rem;
        border-radius: 20px;
        background: rgba(224, 225, 221, 0.75);
        border: 1px solid rgba(63, 66, 56, 0.12);
    }
    .challenge-block h3 {
        margin-top: 0;
        margin-bottom: 0.75rem;
        color: #1f2937;
    }
    .challenge-block ul {
        margin: 0;
        padding-left: 1.35rem;
        color: #475569;
        line-height: 1.8;
    }
    .challenge-block li {
        margin-bottom: 0.75rem;
    }

    .grid--solution {
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        margin-bottom: 1.5rem;
    }
    .solution-card {
        padding: 2rem 1.5rem 1.5rem;
        border-radius: 24px;
        background: rgba(127, 71, 144, 0.06);
        border: 1px solid rgba(79, 70, 229, 0.18);
        box-shadow: 0 14px 28px rgba(79, 70, 229, 0.08);
        text-align: left;
    }
    .solution-card h3 {
        margin-top: 0;
        color: var(--color-contraste-1);
        font-size: 1.15rem;
    }
    .solution-card p {
        margin: 1rem 0 0;
        color: var(--color-parrafo);
        line-height: 1.75;
    }
    .solution-highlight {
        background: #eef2ff;
        padding: 1.5rem 1.75rem;
        border-radius: 20px;
        border: 1px solid rgba(99, 102, 241, 0.16);
        max-width: 760px;
        margin: 0 auto;
    }
    .solution-highlight h3 {
        margin: 0 0 0.5rem;
        color: #111827;
    }

    .grid--impact {
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        margin-bottom: 1.5rem;
    }
    .impact-card {
        background: #ffffff;
        border-radius: 20px;
        padding: 1.5rem;
        border: 1px solid rgba(79, 70, 229, 0.12);
        box-shadow: 0 14px 28px rgba(79, 70, 229, 0.05);
        text-align: left;
    }
    .impact-card strong {
        display: block;
        font-size: 2rem;
        color: #4338ca;
        margin-bottom: 0.75rem;
    }
    .impact-card p {
        margin: 0;
        color: #475569;
        line-height: 1.8;
    }
    .impact-details {
        max-width: 760px;
        margin: 0 auto;
        color: #475569;
        line-height: 1.8;
        display: grid;
        gap: 0.9rem;
    }

    .grid--roi {
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        margin-bottom: 1.5rem;
    }
    .roi-card {
        padding: 1.5rem;
        border-radius: 20px;
        background: #ffffff;
        border: 1px solid rgba(79, 70, 229, 0.12);
        box-shadow: 0 14px 28px rgba(79, 70, 229, 0.05);
        text-align: left;
    }
    .roi-card h3 {
        margin: 0 0 0.75rem;
        color: #4338ca;
        font-size: 1.05rem;
    }
    .roi-card p {
        margin: 0;
        font-size: 1.35rem;
        color: #111827;
        font-weight: 700;
    }
    .roi-card small {
        display: block;
        margin-top: 0.75rem;
        color: #6b7280;
    }
    .roi-summary {
        max-width: 760px;
        margin: 0 auto;
        padding: 1.75rem;
        background: #f8fafc;
        border-radius: 20px;
        border: 1px solid rgba(148, 163, 184, 0.25);
        color: #1f2937;
        line-height: 1.8;
    }
    .roi-summary p {
        margin: 0.75rem 0;
    }
    .roi-summary strong {
        color: #4338ca;
    }

    .pricing-card {
        max-width: 760px;
        margin: 0 auto;
        padding: 1.75rem;
        border-radius: 20px;
        background: #ffffff;
        border: 1px solid rgba(79, 70, 229, 0.12);
        box-shadow: 0 14px 28px rgba(79, 70, 229, 0.05);
        text-align: left;
    }
    .pricing-card h3 {
        margin: 0 0 0.75rem;
        color: #4338ca;
    }
    .pricing-card p {
        margin: 0.5rem 0;
        color: #475569;
        line-height: 1.75;
    }
    .pricing-note {
        font-weight: 700;
        color: #111827;
        margin-top: 0.5rem;
    }
    .pricing-card ul {
        padding-left: 1.35rem;
        margin: 1rem 0;
        color: #475569;
        line-height: 1.8;
    }

    .grid--services {
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    }
    .service-card {
        padding: 1.5rem;
        border-radius: 20px;
        background: #ffffff;
        border: 1px solid rgba(79, 70, 229, 0.12);
        box-shadow: 0 14px 28px rgba(79, 70, 229, 0.05);
        text-align: left;
    }
    .service-card h3 {
        margin-top: 0;
        color: #4338ca;
        margin-bottom: 0.75rem;
    }
    .service-card p {
        margin: 0.5rem 0;
        color: #475569;
        line-height: 1.7;
    }
    .service-price {
        font-weight: 700;
        color: #111827;
    }

    .standard-grid {
        display: grid;
        gap: 1.25rem;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    }
    .standard-card {
        padding: 1.5rem;
        border-radius: 20px;
        background: #ffffff;
        border: 1px solid rgba(79, 70, 229, 0.12);
        box-shadow: 0 14px 28px rgba(79, 70, 229, 0.05);
        text-align: left;
    }
    .standard-card h3 {
        margin-top: 0;
        color: #4338ca;
        margin-bottom: 0.75rem;
    }
    .standard-card ul {
        padding-left: 1.35rem;
        margin: 0;
        color: #475569;
        line-height: 1.8;
    }
    .standard-card li {
        margin-bottom: 0.75rem;
    }

    .closing-card {
        max-width: 760px;
        margin: 0 auto;
        padding: 2rem;
        background: #eef2ff;
        border-radius: 24px;
        border: 1px solid rgba(99, 102, 241, 0.16);
        text-align: center;
    }
    .closing-card h2 {
        margin: 0 0 0.75rem;
        color: #111827;
    }
    .closing-card p {
        margin: 0;
        color: #475569;
        line-height: 1.8;
    }

    .cta-card {
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 1.5rem;
        align-items: center;
        padding: 2rem 2rem;
        border-radius: 24px;
        background: linear-gradient(135deg, rgba(127, 71, 144, 0.14), rgba(57, 119, 180, 0.12));
        border: 1px solid rgba(127, 71, 144, 0.22);
        box-shadow: 0 18px 40px rgba(79, 70, 229, 0.1);
        max-width: 1000px;
        margin: 0 auto 3rem;
    }
    .cta-card h2 {
        margin: 0.35rem 0 0.85rem;
        font-size: 2.25rem;
        color: #111827;
    }
    .cta-card p {
        margin: 0;
        color: var(--color-parrafo);
        line-height: 1.8;
    }
    .btn-secondary {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 1rem 1.75rem;
        border-radius: 999px;
        background: var(--color-contraste-2);
        color: white;
        font-weight: 700;
        text-decoration: none;
        transition: transform 0.2s ease, background 0.2s ease;
    }
    .btn-secondary:hover {
        transform: translateY(-2px);
        background: #2f65a8;
    }
    .card-icon,
    .solution-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 48px;
        height: 48px;
        border-radius: 16px;
        background: var(--color-contraste-2);
        color: white;
        font-size: 1.35rem;
        margin-bottom: 1rem;
    }
    .solution-card {
        position: relative;
        padding-top: 1.5rem;
    }
    .solution-card h3 {
        margin-top: 0;
        color: var(--color-contraste-1);
        font-size: 1.2rem;
    }
    .solution-card p {
        margin: 1rem 0 0;
    }

    @media (max-width: 880px) {
        .grid--challenge,
        .grid--solution,
        .grid--impact,
        .grid--roi,
        .grid--services,
        .standard-grid {
            grid-template-columns: 1fr;
        }
    }

    @media (max-width: 640px) {
        main {
            padding: 1.5rem 1rem;
        }
        .section {
            padding: 0;
        }
        .hero {
            padding: 1.5rem 0 1rem;
        }
    }
</style>
