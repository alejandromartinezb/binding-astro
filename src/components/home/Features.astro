---
// src/components/home/Features.astro

const features = [
  { title: "Nativo Digital", desc: "Nacidos en la era tecnológica para dominarla." },
  { title: "Personalización", desc: "Software que se adapta a ti, no al revés." },
  { title: "Eficiencia", desc: "Optimizamos procesos para ahorrarte tiempo real." }
];
---
<section class="features">
  {features.map(f => (
    <div class="feature-card">
      <h3>{f.title}</h3>
      <p>{f.desc}</p>
    </div>
  ))}
</section>

<style>
  .features { padding: 4rem 1.5rem; display: grid; gap: 2rem; }
  .feature-card { padding: 2rem; border-radius: 12px; background: #f8fafc; border-left: 4px solid #3b82f6; }
  h3 { margin-bottom: 0.5rem; color: #1e293b; }
  
  /* Escritorio */
  @media (min-width: 768px) {
    .features { grid-template-columns: repeat(3, 1fr); max-width: 1200px; margin: 0 auto; }
  }
</style>
