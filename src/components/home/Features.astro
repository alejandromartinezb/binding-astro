---
// src/components/home/Features.astro
// Sección con las características principales de Binding.

const features = [
    {
        title: "Check-in ultrarrápido",
        desc: "Menos tiempo en recepción y mejor llegada del huésped.",
    },
    {
        title: "Sistemas conectados",
        desc: "Integración con PMS y flujos operativos del hotel.",
    },
    {
        title: "Control corporativo",
        desc: "Más visibilidad, trazabilidad y escalabilidad para cadenas.",
    },
];
---

<section class="features">
    <div class="container">
        {
            features.map((f) => (
                <div class="feature-card">
                    <div class="divider" />
                    <h3>{f.title}</h3>
                    <p>{f.desc}</p>
                </div>
            ))
        }
    </div>
</section>

<style>
    .features {
        padding: 5rem 1.5rem;
        background: #f1f5f9;
    }

    .container {
        display: grid;
        gap: 2rem;
        max-width: 1100px;
        margin: 0 auto;
    }

    .feature-card {
        padding: 2.5rem 2rem;
        background: #ffffff;
        border-radius: 12px;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
        border: 1px solid #f1f5f9;
    }

    .divider {
        width: 40px;
        height: 3px;
        background: #3b82f6;
        margin-bottom: 1.5rem;
    }

    h3 {
        margin-bottom: 1rem;
        color: #0f172a;
        font-size: 1.4rem;
        font-weight: 700;
        line-height: 1.2;
    }

    p {
        color: #475569;
        line-height: 1.6;
        font-size: 1.05rem;
    }

    @media (min-width: 768px) {
        .container {
            grid-template-columns: repeat(3, 1fr);
        }
    }
</style>
