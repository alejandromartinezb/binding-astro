---
import { getMessages, t, getPathWithLang } from "../../utils/i18n";
const { lang = 'es' } = Astro.props;
const messages = getMessages(lang);
const solutions = messages.home.solutions.cards.map((card) => ({
  ...card,
  link: card.link ? getPathWithLang(card.link, lang) : undefined,
}));
---

<!-- Sección principal de soluciones -->
<section class="solutions">
  <!-- Encabezado con título y descripción -->
  <div class="header">
    <!-- Pequeño texto superior en mayúsculas (eyebrow) -->
    <p class="eyebrow">Soluciones</p>
    <!-- Título principal -->
    <h2>Lo que ofrece Binding</h2>
    <!-- Descripción corta de qué hace esta sección -->
    <p class="subtitle">Todas las herramientas para automatizar el check-in, gestionar datos y cumplir con tus operaciones hoteleras.</p>
  </div>

  <!-- Grid donde van todas las tarjetas de soluciones -->
  <div class="grid">
    <!-- Recorremos el array de solutions y creamos una tarjeta para cada una -->
    {
      solutions.map((solution) => (
        <article class="card">
          <!-- Cabecera de la tarjeta: icono + título -->
          <div class="card-head">
            <!-- Icono con color diferente según el tipo de solución -->
            <!-- Usamos la clase "icon-{id}" para pintar cada icono de un color -->
            <span class={`icon icon-${solution.id}`} aria-hidden="true" />
            <!-- Título de la solución -->
            <h3>{solution.title}</h3>
          </div>
          <!-- Descripción o texto de la solución -->
          <p>{solution.text}</p>
          {solution.link ? (
            <a class="card-link" href={solution.link}>{solution.linkText}</a>
          ) : null}
        </article>
      ))
    }
  </div>
</section>

<style>
  /* CONTENEDOR PRINCIPAL */
  /* Estilos generales de la sección */
  .solutions {
    padding: 5rem 1.5rem;
    background: #f1f5f9;
    color: #0f172a;
  }

  /* ENCABEZADO (HEADER) */
  /* Estilos del área de título y descripción */
  .header {
    max-width: 760px;
    margin: 0 auto 2.5rem;
    text-align: center;
  }

  /* Texto pequeño en mayúsculas encima del título */
  .eyebrow {
    display: inline-block;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: #3b82f6;
    font-weight: 700;
    margin-bottom: 0.75rem;
    font-size: 0.85rem;
  }

  /* Título principal H2 */
  h2 {
    margin: 0;
    font-size: 2.2rem;
    line-height: 1.2;
    color: #0f172a;
  }

  /* Descripción o subtítulo debajo del H2 */
  .subtitle {
    margin: 1rem auto 0;
    max-width: 640px;
    color: #475569;
    line-height: 1.75;
    font-size: 1rem;
  }

  /* GRID DE TARJETAS */
  /* Contenedor grid para organizar las tarjetas en filas/columnas */
  .grid {
    display: grid;
    gap: 1.5rem;
  }

  /* TARJETA INDIVIDUAL */
  /* Estilos de cada tarjeta de solución */
  .card {
    padding: 2rem;
    border-radius: 12px;
    border: 1px solid #e2e8f0;
    background: #ffffff;
    box-shadow: 0 4px 6px -1px rgba(15, 23, 42, 0.08);
  }

  /* Cabecera de la tarjeta: icono + título en fila */
  .card-head {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  /* ICONOS */
  /* Estilo base para todos los iconos */
  .icon {
    width: 40px;
    height: 40px;
    min-width: 40px;
    border-radius: 14px;
    flex-shrink: 0;
  }

  /* Colores individuales de cada icono (gradientes) */
  .icon-checkin {
    background: linear-gradient(135deg, #7c3aed, #a855f7);
  }
  .icon-paperless {
    background: linear-gradient(135deg, #0ea5e9, #22d3ee);
  }
  .icon-imagen-corporativa {
    background: linear-gradient(135deg, #ec4899, #f472b6);
  }
  .icon-textos-legales {
    background: linear-gradient(135deg, #f97316, #fb923c);
  }
  .icon-analitica {
    background: linear-gradient(135deg, #10b981, #34d399);
  }
  .icon-actualizaciones {
    background: linear-gradient(135deg, #2563eb, #3b82f6);
  }
  .icon-pms {
    background: linear-gradient(135deg, #14b8a6, #06b6d4);
  }
  .icon-campos-personalizados {
    background: linear-gradient(135deg, #ef4444, #f87171);
  }
  .icon-precheck {
    background: linear-gradient(135deg, #8b5cf6, #c084fc);
  }
  .icon-autoridades {
    background: linear-gradient(135deg, #22c55e, #84cc16);
  }
  .icon-corporate-manager {
    background: linear-gradient(135deg, #0f766e, #2dd4bf);
  }
  .icon-api {
    background: linear-gradient(135deg, #2563eb, #60a5fa);
  }
  .icon-identity-point {
    background: linear-gradient(135deg, #ea580c, #f59e0b);
  }

  /* TEXTOS DENTRO DE LAS TARJETAS */
  /* Título de cada solución */
  h3 {
    margin: 0;
    font-size: 1.25rem;
    line-height: 1.3;
    color: #0f172a;
  }

  /* Descripción/texto de cada solución */
  p {
    margin: 0;
    color: #475569;
    line-height: 1.75;
    font-size: 1rem;
  }

  .card-link {
    display: inline-flex;
    margin-top: 1rem;
    color: #4338ca;
    font-weight: 700;
    text-decoration: none;
  }

  .card-link:hover {
    text-decoration: underline;
  }

  .card-link {
    display: inline-flex;
    margin-top: 1rem;
    color: #4338ca;
    font-weight: 700;
    text-decoration: none;
  }
  .card-link:hover {
    text-decoration: underline;
  }

  /* RESPONSIVE - Tablets */
  /* En pantallas mayores a 768px mostramos 2 columnas */
  @media (min-width: 768px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* RESPONSIVE - Ordenadores */
  /* En pantallas mayores a 1024px mostramos 3 columnas */
  @media (min-width: 1024px) {
    .grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
