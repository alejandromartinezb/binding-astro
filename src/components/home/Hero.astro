---
// src/components/home/Hero.astro
// Sección principal del home con mensaje principal y botón.
---

<section class="hero">
    <div class="content">
        <span class="eyebrow">BINDING IDENTITY PARA HOTELES</span>
        <h1>Check-in en <br /> <span>20 segundos</span></h1>
        <p class="description">
            Binding Identity Technology hecho por hoteleros para hoteleros
        </p>
        <div class="actions">
            <a href="#contacto" class="btn-outline">Contáctanos</a>
        </div>
    </div>
</section>

<style>
    .hero {
        background-color: #f1f5f9;
        color: #0f172a;
        padding: 6rem 1.5rem;
        text-align: center;
        min-height: 70vh;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .eyebrow {
        font-size: 0.9rem;
        letter-spacing: 2px;
        color: #64748b;
        text-transform: uppercase;
        font-weight: 700;
        margin-bottom: 1rem;
        display: block;
    }

    h1 {
        font-size: 4rem;
        line-height: 1;
        margin-bottom: 1.5rem;
        font-weight: 800;
        color: #0f172a;
    }

    h1 span {
        color: var(--color-contraste-2);
    }

    .description {
        font-size: 1.25rem;
        color: #475569;
        margin-bottom: 2.5rem;
        max-width: 600px;
        margin-left: auto;
        margin-right: auto;
    }

    .actions {
        display: flex;
        justify-content: center;
    }

    .btn-outline {
        background: transparent;
        color: #0f172a;
        padding: 0.8rem 2.5rem;
        border-radius: 8px;
        text-decoration: none;
        border: 2px solid #0f172a;
        font-weight: bold;
        transition: all 0.3s ease;
    }

    .btn-outline:hover {
        background: #0f172a;
        color: #ffffff;
    }

    @media (max-width: 768px) {
        h1 {
            font-size: 2.8rem;
        }
        .hero {
            min-height: 60vh;
        }
    }
</style>
