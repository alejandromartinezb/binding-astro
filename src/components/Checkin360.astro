---
interface Option {
    titulo: string;
    descripcion: string;
    pts: number;
    icon: string;
    color: string;
}

interface Step {
    categoria: string;
    descripcion: string;
    opciones: Option[];
}

interface Props {
    pasos: Step[];
}

const { pasos = [] }: Props = Astro.props;
---

// Componente interactivo que muestra un quiz de check-in 360.
// Recibe un array de pasos y opciones desde el padre.
<div class="binding-quiz">
    <div id="binding-quiz-ui" class="binding-quiz__ui">
        <div class="binding-progress">
            <p class="binding-progress__label">
                Paso <span id="binding-current-step">1</span> de {pasos.length}
            </p>
            <div class="binding-progress__bar-bg">
                <div id="binding-bar-fill" class="binding-progress__bar-fill"></div>
            </div>
        </div>

        <div id="binding-steps" class="binding-steps">
            {pasos.map((paso, index) => (
                <section
                    class={`binding-step ${
                        index === 0
                            ? "binding-step--active"
                            : "binding-step--hidden"
                    }`}
                    data-step={index}
                >
                    <div class="binding-step__header">
                        <h2>{paso.categoria}</h2>
                        <p>{paso.descripcion}</p>
                    </div>

                    <div class="binding-options">
                        {paso.opciones.map((opt) => (
                            <button
                                type="button"
                                class="binding-option"
                                data-pts={opt.pts}
                                data-title={opt.titulo}
                            >
                                <div
                                    class={`binding-option__icon bg-gradient-to-br ${opt.color}`}
                                >
                                    {opt.icon}
                                </div>
                                <span class="binding-option__title">{opt.titulo}</span>
                                <span class="binding-option__description">
                                    {opt.descripcion}
                                </span>
                            </button>
                        ))}
                    </div>
                </section>
            ))}
        </div>
    </div>

    <div id="binding-results" class="binding-results binding-results--hidden">
        <div class="binding-results__card">
            <h3>Resultado Check-in 360</h3>
            <div class="binding-results__score">
                <span id="binding-final-score">0</span>%
            </div>
            <div class="binding-results__riskbar">
                <div id="binding-risk-fill" class="binding-results__risk-fill"></div>
            </div>
            <p id="binding-risk-label" class="binding-results__risk-label"></p>
            <p id="binding-feedback" class="binding-results__feedback"></p>
            <button
                type="button"
                onclick="location.reload()"
                class="binding-results__reset"
            >
                Reiniciar configuración
            </button>
        </div>
    </div>
</div>

<script>
    const initBindingQuiz = () => {
        let currentStep = 0;
        const totalPoints: number[] = [];
        const selectedTitles: string[] = [];

        const stepBoxes = document.querySelectorAll<HTMLElement>(
            ".binding-step"
        );
        const optionButtons = document.querySelectorAll<HTMLButtonElement>(
            ".binding-option"
        );
        const bar = document.getElementById("binding-bar-fill");
        const currentStepEl = document.getElementById("binding-current-step");

        const updateProgress = () => {
            if (currentStepEl) {
                currentStepEl.innerText = (currentStep + 1).toString();
            }
            if (bar) {
                bar.style.width =
                    ((currentStep + 1) / stepBoxes.length) * 100 + "%";
            }
        };

        updateProgress();

        const getRiskLabel = (score: number) => {
            if (score >= 90) return "Muy seguro";
            if (score >= 70) return "Seguridad moderada";
            if (score >= 45) return "Riesgo medio";
            return "Muy peligroso";
        };

        const getRiskColor = (score: number) => {
            if (score >= 90) return "#22c55e";
            if (score >= 70) return "#f59e0b";
            if (score >= 45) return "#f97316";
            return "#dc2626";
        };

        const getSummaryText = (score: number, choices: string[]) => {
            const usesManual = choices.some((title) =>
                /Manual|Físico|Escáner|No sé si incumplo|Incumplo la ley/i.test(title)
            );
            const usesPaper = choices.some((title) =>
                /Todo en papel|Tablet y papel/i.test(title)
            );
            const usesDigital = choices.some((title) =>
                /Lectura digital|Todo electrónico|Certificado legal|Comprobación tecnológica/i.test(title)
            );

            if (score >= 90) {
                return `Tu elección es muy segura. Reduces el riesgo de sanciones y puedes ahorrar entre 18.000€ y 25.000€ en personal, además de 10.000-15.000€ en papel y gestión. Esta es una visión 360 del check-in: cada fase se refuerza entre sí y la seguridad/legalidad crece como una rueda completa.`;
            }

            if (score >= 70) {
                return `Tienes una solución mayoritariamente tecnológica, pero aún hay márgenes de mejora. Como un check-in 360, tus decisiones se retroalimentan: si hay papel o control visual, sigues con riesgo moderado de errores y costes extra de hasta 8.000€.`;
            }

            if (score >= 45) {
                return `Tu configuración es vulnerable. Con OCR/escáner o comprobación visual ya tienes probabilidad de errores de datos y retardos, y los costes extra pueden ser de 6.000-15.000€ al año. En un proceso 360, esto también reduce tu capacidad de asegurar legalidad total.`;
            }

            return `Muy peligroso: estás usando procesos manuales o papel completo. Esto aumenta el riesgo de fallos, retrasos y sanciones. Si no corriges, podrías afrontar multas de 6.000-60.000€ por hotel y gastos adicionales de hasta 15.000€ en papel y gestión. Recuerda que en el check-in 360 una mala elección en un paso afecta a toda la rueda de seguridad y legalidad.`;
        };

        optionButtons.forEach((btn) => {
            btn.addEventListener("click", () => {
                totalPoints.push(parseInt(btn.dataset.pts || "0", 10));
                if (btn.dataset.title) {
                    selectedTitles.push(btn.dataset.title);
                }

                if (currentStep < stepBoxes.length - 1) {
                    stepBoxes[currentStep].classList.replace(
                        "binding-step--active",
                        "binding-step--hidden"
                    );
                    currentStep += 1;
                    stepBoxes[currentStep].classList.replace(
                        "binding-step--hidden",
                        "binding-step--active"
                    );
                    updateProgress();
                } else {
                    mostrarResultados();
                }
            });
        });

        function mostrarResultados() {
            document
                .getElementById("binding-quiz-ui")
                ?.classList.add("binding-quiz__hidden");
            document
                .getElementById("binding-results")
                ?.classList.remove("binding-results--hidden");

            const suma = totalPoints.reduce((a, b) => a + b, 0);
            const media = totalPoints.length
                ? Math.round(suma / totalPoints.length)
                : 0;

            const scoreEl = document.getElementById("binding-final-score");
            if (scoreEl) scoreEl.innerText = media.toString();

            const riskFill = document.getElementById("binding-risk-fill");
            const riskLabel = document.getElementById("binding-risk-label");
            const riskText = getRiskLabel(media);
            const riskColor = getRiskColor(media);

            if (riskFill) {
                riskFill.style.width = `${media}%`;
                riskFill.style.backgroundColor = riskColor;
            }
            if (riskLabel) {
                riskLabel.innerText = `${riskText} — Nivel de riesgo estimado`;
            }

            const feedback = document.getElementById("binding-feedback");
            if (feedback) {
                feedback.innerText = getSummaryText(media, selectedTitles);
            }
        }
    };

    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initBindingQuiz);
    } else {
        initBindingQuiz();
    }
</script>

<style>
    .binding-quiz {
        max-width: 800px;
        margin: 2rem auto;
        font-family: system-ui, sans-serif;
        text-align: left;
    }

    .binding-progress {
        margin-bottom: 1.75rem;
    }

    .binding-progress__label {
        font-weight: 700;
    }

    .binding-progress__bar-bg {
        background: #e2e8f0;
        height: 12px;
        border-radius: 999px;
        overflow: hidden;
        margin-top: 0.75rem;
    }

    .binding-progress__bar-fill {
        background: #4f46e5;
        width: 25%;
        height: 100%;
        transition: width 0.4s ease;
    }

    .binding-step--hidden {
        display: none;
    }

    .binding-step--active {
        display: block;
        animation: fadeIn 0.35s ease;
    }

    .binding-step__header h2 {
        margin-bottom: 0.5rem;
        color: #111827;
    }

    .binding-step__header p {
        color: #475569;
    }

    .binding-options {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 1rem;
        margin-top: 2rem;
    }

    .binding-option {
        background: white;
        border: 2px solid #e2e8f0;
        border-radius: 1rem;
        padding: 1.5rem;
        cursor: pointer;
        transition: transform 0.2s ease, border-color 0.2s ease;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        min-height: 190px;
    }

    .binding-option:hover {
        border-color: #4f46e5;
        transform: translateY(-2px);
    }

    .binding-option__icon {
        width: 60px;
        height: 60px;
        border-radius: 999px;
        display: grid;
        place-items: center;
        margin-bottom: 1rem;
        font-size: 1.6rem;
        color: white;
    }

    .binding-option__title {
        font-weight: 700;
        margin-bottom: 0.5rem;
        color: #111827;
    }

    .binding-option__description {
        color: #475569;
        font-size: 0.95rem;
        line-height: 1.4;
    }

    .binding-results {
        display: block;
    }

    .binding-results--hidden {
        display: none;
    }

    .binding-quiz__hidden {
        display: none;
    }

    .binding-results__card {
        background: #f8fafc;
        border-radius: 1.75rem;
        padding: 3rem;
        text-align: center;
    }

    .binding-results__score {
        font-size: 4rem;
        font-weight: 800;
        color: #4f46e5;
        margin: 1rem 0;
    }

    .binding-results__riskbar {
        width: 100%;
        height: 16px;
        background: #e2e8f0;
        border-radius: 999px;
        overflow: hidden;
        margin: 1rem 0;
    }

    .binding-results__risk-fill {
        width: 0;
        height: 100%;
        transition: width 0.5s ease, background-color 0.5s ease;
    }

    .binding-results__risk-label {
        font-weight: 700;
        margin-bottom: 1rem;
        color: #1f2937;
    }

    .binding-results__feedback {
        color: #475569;
        line-height: 1.75;
        margin-bottom: 1.5rem;
    }

    .binding-results__reset {
        margin-top: 1.75rem;
        background: transparent;
        border: none;
        color: #64748b;
        text-decoration: underline;
        cursor: pointer;
    }

    .bg-gradient-to-br {
        background-image: linear-gradient(
            to bottom right,
            var(--tw-gradient-stops, #4f46e5, #9333ea)
        );
    }

    @keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(12px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>
