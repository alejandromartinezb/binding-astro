---
import Checkin360 from "../Checkin360.astro";

// Opciones que muestra el configurador. Son los pasos y opciones del quiz.
const pasosConfigurador = [
    {
        categoria: "Lectura",
        descripcion: "¿Cómo capturas los datos del DNI/Pasaporte?",
        opciones: [
            {
                titulo: "Manual",
                descripcion:
                    "Fallos humanos y tiempos de más de 5 minutos por check-in.",
                pts: 15,
                icon: "⌨️",
                color: "from-gray-400 to-gray-500",
            },
            {
                titulo: "OCR",
                descripcion:
                    "Tecnología obsoleta con fallos de lectura y datos incompletos. Tiempo medio 3-4 minutos.",
                pts: 35,
                icon: "📸",
                color: "from-blue-400 to-blue-500",
            },
            {
                titulo: "Escáner",
                descripcion:
                    "Tecnología obsoleta con fallos de lectura y datos incompletos. Tiempo medio 3-4 minutos.",
                pts: 35,
                icon: "🖨️",
                color: "from-orange-400 to-red-500",
            },
            {
                titulo: "Lectura digital",
                descripcion:
                    "Lectura 100% veraz del documento electrónico. Check-in en 20 segundos. Ahorro de 400-600 min/día y 18.000-25.000€ al año/hotel.",
                pts: 100,
                icon: "⚡",
                color: "from-indigo-500 to-purple-600",
            },
        ],
    },
    {
        categoria: "Veracidad del dato",
        descripcion: "¿Cómo verificas que el dato sea real y correcto?",
        opciones: [
            {
                titulo: "Comprobación visual",
                descripcion:
                    "Lenta y abierta a errores humanos por el trabajador.",
                pts: 20,
                icon: "👁️",
                color: "from-gray-500 to-gray-700",
            },
            {
                titulo: "Comprobación tecnológica",
                descripcion:
                    "Rápida y veraz con un sistema automático de Binding.",
                pts: 100,
                icon: "🤖",
                color: "from-indigo-500 to-purple-600",
            },
        ],
    },
    {
        categoria: "Paperless",
        descripcion: "¿Cómo gestionas los documentos y la llegada del huésped?",
        opciones: [
            {
                titulo: "Todo en papel",
                descripcion:
                    "Gasto extra de 10.000-15.000€ de media por hotel.",
                pts: 10,
                icon: "📄",
                color: "from-red-400 to-pink-500",
            },
            {
                titulo: "Tablet y papel",
                descripcion:
                    "Gasto extra de 6.000-8.000€ con soluciones mixtas.",
                pts: 55,
                icon: "📱",
                color: "from-amber-400 to-orange-500",
            },
            {
                titulo: "Todo electrónico",
                descripcion:
                    "Ahorro de 10.000-15.000€ en papel y gestión con una solución electrónica completa.",
                pts: 100,
                icon: "✍️",
                color: "from-indigo-500 to-purple-600",
            },
        ],
    },
    {
        categoria: "Legalidad",
        descripcion: "¿Cómo de seguro estás frente a sanciones y leyes de protección?",
        opciones: [
            {
                titulo: "Incumplo la ley",
                descripcion:
                    "Expuesto a multas de 6.000€ a 60.000€ por hotel.",
                pts: 10,
                icon: "⚠️",
                color: "from-orange-400 to-red-500",
            },
            {
                titulo: "No sé si incumplo",
                descripcion:
                    "Expuesto a multas de 6.000€ a 60.000€ por hotel.",
                pts: 35,
                icon: "❓",
                color: "from-amber-400 to-orange-500",
            },
            {
                titulo: "Certificado legal",
                descripcion:
                    "Cumple las 3 leyes vigentes. Tranquilidad ante reclamaciones de protección de datos.",
                pts: 100,
                icon: "⚖️",
                color: "from-indigo-500 to-purple-600",
            },
        ],
    },
];
---

<!-- Mostramos el componente del quiz con los pasos definidos arriba -->
<Checkin360 pasos={pasosConfigurador} />
