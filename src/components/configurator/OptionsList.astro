---
import Checkin360 from "../Checkin360.astro";

// Opciones que muestra el configurador. Son los pasos y opciones del quiz.
const pasosConfigurador = [
    {
        categoria: "Lectura",
        descripcion: "¿Cómo capturas los datos del DNI/Pasaporte?",
        opciones: [
            {
                titulo: "Manual",
                descripcion:
                    "Lectura de los datos manualmente por un trabajador.",
                pts: 15,
                icon: "⌨️",
                color: "from-gray-400 to-gray-500",
            },
            {
                titulo: "OCR",
                descripcion:
                    "Extracción de datos mediante reconocimiento óptico de caracteres.",
                pts: 35,
                icon: "📸",
                color: "from-blue-400 to-blue-500",
            },
            {
                titulo: "Escáner",
                descripcion:
                    "Captura de la imagen del documento con un escáner físico.",
                pts: 35,
                icon: "🖨️",
                color: "from-orange-400 to-red-500",
            },
            {
                titulo: "Lectura digital",
                descripcion:
                    "Lectura directa de datos desde el documento electrónico.",
                pts: 100,
                icon: "⚡",
                color: "from-indigo-500 to-purple-600",
            },
        ],
    },
    {
        categoria: "Veracidad del dato",
        descripcion: "¿Cómo verificas que el dato sea real y correcto?",
        opciones: [
            {
                titulo: "Comprobación visual",
                descripcion:
                    "Verificación manual de los datos por parte del trabajador.",
                pts: 20,
                icon: "👁️",
                color: "from-gray-500 to-gray-700",
            },
            {
                titulo: "Comprobación tecnológica",
                descripcion:
                    "Validación automática de los datos con tecnología Binding.",
                pts: 100,
                icon: "🤖",
                color: "from-indigo-500 to-purple-600",
            },
        ],
    },
    {
        categoria: "Paperless",
        descripcion: "¿Cómo gestionas los documentos y la llegada del huésped?",
        opciones: [
            {
                titulo: "Todo en papel",
                descripcion:
                    "Gestión completa de documentos en formato físico.",
                pts: 10,
                icon: "📄",
                color: "from-red-400 to-pink-500",
            },
            {
                titulo: "Tablet y papel",
                descripcion:
                    "Uso mixto de tablet y documentos impresos.",
                pts: 55,
                icon: "📱",
                color: "from-amber-400 to-orange-500",
            },
            {
                titulo: "Todo electrónico",
                descripcion:
                    "Gestión totalmente digital de los documentos y firmas.",
                pts: 100,
                icon: "✍️",
                color: "from-indigo-500 to-purple-600",
            },
        ],
    },
    {
        categoria: "Legalidad",
        descripcion: "¿Cómo de seguro estás frente a sanciones y leyes de protección?",
        opciones: [
            {
                titulo: "Incumplo la ley",
                descripcion:
                    "No aplicas las medidas legales de protección de datos.",
                pts: 10,
                icon: "⚠️",
                color: "from-orange-400 to-red-500",
            },
            {
                titulo: "No sé si incumplo",
                descripcion:
                    "No tienes claro si todos tus procesos son conformes.",
                pts: 35,
                icon: "❓",
                color: "from-amber-400 to-orange-500",
            },
            {
                titulo: "Certificado legal",
                descripcion:
                    "Cuentas con un certificado que avala el cumplimiento legal.",
                pts: 100,
                icon: "⚖️",
                color: "from-indigo-500 to-purple-600",
            },
        ],
    },
];
---

<!-- Mostramos el componente del quiz con los pasos definidos arriba -->
<Checkin360 pasos={pasosConfigurador} />
