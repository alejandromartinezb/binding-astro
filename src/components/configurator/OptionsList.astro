---
import Checkin360 from "../Checkin360.astro";
import { getMessages } from "../../utils/i18n";

const { lang = 'es' } = Astro.props;
const messages = getMessages(lang);
const pasosConfigurador = messages.configurador.options;
---

<!-- Mostramos el componente del quiz con los pasos definidos en el diccionario -->
<Checkin360 pasos={pasosConfigurador} lang={lang} />
