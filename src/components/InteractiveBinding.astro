---
// Parte del servidor
---

<div class="game-container">
    <div class="header-juego">
        <h2>Personaliza tu estancia</h2>
        <p class="score">Puntos: <span id="puntos">0</span></p>
    </div>

    <div class="opciones">
        <button class="item" data-puntos="50">
            <span class="icon">💻</span> Añadir Tecnología
        </button>
        <button class="item" data-puntos="30">
            <span class="icon">🛌</span> Añadir Confort
        </button>
        <button class="item" data-puntos="40">
            <span class="icon">🛁</span> Baño Premium
        </button>
    </div>

    <button id="reset" class="reset-btn">Reiniciar Reserva</button>
</div>

<script>
    // @ts-nocheck
    // Para evitar los errores de TypeScript

    // 1. Seleccionamos los elementos del DOM
    let totalPuntos = 0;
    const displayPuntos = document.getElementById("puntos");
    const botones = document.querySelectorAll(".item");
    const btnReset = document.getElementById("reset");

    // 2. Lógica para sumar puntos
    botones.forEach((boton) => {
        boton.addEventListener("click", () => {
            // Obtenemos los puntos del atributo data-puntos
            const valor = parseInt(boton.getAttribute("data-puntos"));

            totalPuntos += valor;
            displayPuntos.innerText = totalPuntos;

            // Desactivamos el botón para que no se pulse dos veces
            boton.disabled = true;
            boton.classList.add("selected");
        });
    });

    // 3. Lógica para reiniciar el "juego"
    btnReset.addEventListener("click", () => {
        totalPuntos = 0;
        displayPuntos.innerText = "0";
        botones.forEach((boton) => {
            boton.disabled = false;
            boton.classList.remove("selected");
        });
    });
</script>

<style>
    .game-container {
        background: #f9f9f9;
        padding: 2rem;
        border-radius: 15px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
        max-width: 500px;
        margin: 2rem auto;
        text-align: center;
        font-family: sans-serif;
    }

    .header-juego {
        margin-bottom: 1.5rem;
    }

    .score {
        font-size: 1.5rem;
        font-weight: bold;
        color: #4f46e5;
    }

    .opciones {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        margin-bottom: 2rem;
    }

    .item {
        background: white;
        border: 2px solid #e5e7eb;
        padding: 1rem;
        border-radius: 10px;
        cursor: pointer;
        font-size: 1rem;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
    }

    .item:hover:not(:disabled) {
        border-color: #4f46e5;
        background: #f5f3ff;
    }

    .item.selected {
        background: #dcfce7;
        border-color: #22c55e;
        cursor: not-allowed;
    }

    .reset-btn {
        background: none;
        border: none;
        color: #6b7280;
        text-decoration: underline;
        cursor: pointer;
        font-size: 0.9rem;
    }

    .icon {
        font-size: 1.2rem;
    }
</style>
