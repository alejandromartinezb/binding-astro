---
import "../styles/variables.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

// El layout general de la web es el mismo para todas las páginas.
// Incluye el header, el footer y un slot donde se renderiza el contenido.
const { title = "Binding Software" } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>

		<!-- Fuente no comercial de google (Nunito Sans). La fuente Avenir sí era comercial -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Nunito+Sans:ital,wght@0,200..900;1,200..900&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<Header />

		<main>
			<!-- Aquí va el contenido específico de cada página -->
			<slot />
		</main>

		<Footer />
	</body>
</html>

<style is:global>
	html,
	body {
		margin: 0;
		width: 100%;
		min-height: 100%; /* Para evitar que el footer flote */
		display: flex;
		flex-direction: column;
		font-family: 'Nunito Sans', sans-serif;
	}

	main {
		flex: 1; /* Empuja el footer al final */
	}
</style>
