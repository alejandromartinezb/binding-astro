---
import "../styles/variables.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CookieBanner from "../components/CookieBanner.astro";

// El layout general de la web es el mismo para todas las páginas.
// Incluye el header, el footer y un slot donde se renderiza el contenido.
const { title = "Binding Software" } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>

		<!-- Fuente no comercial de google (Nunito Sans). La fuente Avenir sí era comercial -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Nunito+Sans:ital,wght@0,200..900;1,200..900&display=swap"
			rel="stylesheet"
		/>
	</head>

	<!-- Helper de cookies disponible globalmente en `window.cookieUtils` -->
	<script>
		window.cookieUtils = {
			setCookie(name: string, value: string, days?: number) {
				const v = encodeURIComponent(value);
				let cookie = name + '=' + v + '; path=/; SameSite=Lax';
				if (typeof days === 'number') {
					const expires = new Date(Date.now() + days * 864e5).toUTCString();
					cookie += '; expires=' + expires;
				}
				document.cookie = cookie;
			},
			getCookie(name: string) {
				const match = document.cookie.split('; ').find(row => row.startsWith(name + '='));
				if (!match) return '';
				return decodeURIComponent(match.split('=')[1]);
			},
			deleteCookie(name: string) {
				document.cookie = name + '=; path=/; expires=Thu, 01 Jan 1970 00:00:00 GMT';
			}
		};

		window.storageUtils = {
			setLocal(name: string, value: string) {
				localStorage.setItem(name, value);
			},
			getLocal(name: string) {
				return localStorage.getItem(name) ?? '';
			},
			deleteLocal(name: string) {
				localStorage.removeItem(name);
			},
			setJSON(name: string, value: unknown) {
				localStorage.setItem(name, JSON.stringify(value));
			},
			getJSON(name: string) {
				const item = localStorage.getItem(name);
				if (!item) return null;
				try {
					return JSON.parse(item);
				} catch {
					return null;
				}
			}
		};

		const parseConsentPrefs = () => {
			const defaultPrefs = { functional: false, analytics: false };
			try {
				const raw = window.cookieUtils.getCookie('cookie_consent_prefs');
				if (!raw) return defaultPrefs;
				return JSON.parse(raw);
			} catch {
				return defaultPrefs;
			}
		};

		const consentPrefs = parseConsentPrefs();
		const functionalConsent = consentPrefs.functional;
		const analyticsConsent = consentPrefs.analytics;
		const consentAccepted = window.cookieUtils.getCookie('cookie_consent') === 'accepted';

		const applyFunctionalPreferences = () => {
			const lang = window.cookieUtils.getCookie('site_lang');
			if (functionalConsent && lang) {
				document.documentElement.lang = lang;
			}

			const theme = window.storageUtils.getLocal('site_theme');
			if (functionalConsent && theme && theme !== 'auto') {
				document.documentElement.dataset.theme = theme;
			}
		};

		const applyAnalyticsPreferences = () => {
			if (!analyticsConsent) {
				window.storageUtils.deleteLocal('visit_count');
				window.storageUtils.deleteLocal('last_visit');
				window.storageUtils.deleteLocal('last_page');
				window.storageUtils.deleteLocal('last_referrer');
				window.storageUtils.deleteLocal('screen_size');
				window.storageUtils.deleteLocal('browser_lang');
				window.storageUtils.deleteLocal('user_agent');
				return;
			}
			const now = new Date().toISOString();
			const visits = parseInt(window.storageUtils.getLocal('visit_count') || '0', 10) + 1;
			window.storageUtils.setLocal('visit_count', String(visits));
			window.storageUtils.setLocal('last_visit', now);
			window.storageUtils.setLocal('last_page', location.pathname);
			window.storageUtils.setLocal('last_referrer', document.referrer || '');
			window.storageUtils.setLocal('screen_size', `${screen.width}x${screen.height}`);
			window.storageUtils.setLocal('browser_lang', navigator.language || '');
			window.storageUtils.setLocal('user_agent', navigator.userAgent || '');
		};

		(function(){
			try {
				const now = new Date().toISOString();
				const firstVisit = window.storageUtils.getLocal('first_visit');
				if (!firstVisit) {
					window.storageUtils.setLocal('first_visit', now);
				}

				if (functionalConsent) {
					applyFunctionalPreferences();
				}
				applyAnalyticsPreferences();
			} catch(e) {}
		})();
	</script>
	<body>
		<Header />
		<CookieBanner />

		<main>
			<!-- Aquí va el contenido específico de cada página -->
			<slot />
		</main>

		<Footer />
	</body>
</html>

<style is:global>
	html,
	body {
		margin: 0;
		width: 100%;
		min-height: 100%; /* Para evitar que el footer flote */
		display: flex;
		flex-direction: column;
		font-family: 'Nunito Sans', sans-serif;
	}

	main {
		flex: 1; /* Empuja el footer al final */
	}
</style>
